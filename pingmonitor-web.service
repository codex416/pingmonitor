[Unit]
Description=PingMonitor Web Panel
After=network.target


[Service]

User=www-data

WorkingDirectory=/opt/pingmonitor

# Web 管理密码：仅作为首次初始化密码。之后请在控制面板中修改。
Environment=PINGMONITOR_PASSWORD=123456

ExecStart=/usr/bin/python3 /opt/pingmonitor/web.py

Restart=always

RestartSec=5


[Install]

WantedBy=multi-user.target
